rules_version = '2';

// The archive itself is public read - anyone visiting the site can browse
// the cuttings (posts) and the collections they are grouped into (boards).
//
// Being signed in is NOT enough to change anything: the Firebase web api key
// is public, so anyone can mint an account through the Auth REST API. Only a
// user whose uid has a document under /admins counts as an admin, and those
// documents can only be created by hand in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    // Only the fields the app itself writes - nothing smuggled in alongside.
    function postKeysOk(data) {
      return data.keys().hasOnly(['title', 'note', 'imageUrl', 'publicId', 'width', 'height',
        'boardIds', 'ownerUid', 'ownerName', 'source', 'newsDate', 'createdAt']);
    }

    function validPost(data) {
      return data.imageUrl is string
        && data.imageUrl.matches('https://res[.]cloudinary[.]com/.*')
        && data.imageUrl.size() <= 500
        && (!('title' in data) || shortString(data.title, 300))
        && (!('note' in data) || shortString(data.note, 5000))
        && (!('source' in data) || shortString(data.source, 200))
        && (!('ownerName' in data) || shortString(data.ownerName, 80))
        && (!('newsDate' in data) || data.newsDate == null || shortString(data.newsDate, 10))
        && (!('boardIds' in data) || (data.boardIds is list && data.boardIds.size() <= 100));
    }

    function boardKeysOk(data) {
      return data.keys().hasOnly(['name', 'description', 'ownerUid', 'createdAt']);
    }

    // Edits may only touch these fields; everything else is fixed at upload.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validBoard(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && (!('description' in data) || shortString(data.description, 2000));
    }

    // Newspaper cuttings - readable by everyone, writable only by admins.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
                    && postKeysOk(request.resource.data)
                    && validPost(request.resource.data);
      allow update: if isAdmin()
                    && onlyChanges(['title', 'note', 'source', 'newsDate', 'boardIds'])
                    && validPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // Collections / boards - readable by everyone, writable only by admins.
    match /boards/{boardId} {
      allow read: if true;
      allow create: if isAdmin()
                    && boardKeysOk(request.resource.data)
                    && validBoard(request.resource.data);
      allow update: if isAdmin()
                    && onlyChanges(['name', 'description'])
                    && validBoard(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin profiles. Creating or deleting one is console-only - that is
    // what grants or revokes admin rights. An admin may edit their own card.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.auth.uid == uid
                    && onlyChanges(['name', 'role', 'photoUrl', 'photoPublicId'])
                    && (!('photoUrl' in request.resource.data)
                        || request.resource.data.photoUrl == ''
                        || (shortString(request.resource.data.photoUrl, 500)
                            && request.resource.data.photoUrl.matches('https://res[.]cloudinary[.]com/.*')))
                    && (!('name' in request.resource.data) || shortString(request.resource.data.name, 80))
                    && (!('role' in request.resource.data) || shortString(request.resource.data.role, 80));
      allow create, delete: if false;
    }

    // Site-wide visitor tally shown in the public footer. Anyone may bump
    // it, but only by exactly one at a time - never set it to an arbitrary
    // number, and never add other fields.
    match /meta/visitors {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
